{
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "simple-git-hooks",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "check": "tsc --noEmit && node ./scripts/check.ts",
    "build": "tsc --noEmit && node ./scripts/build.ts"
  },
  "devDependencies": {
    "@gkd-kit/define": "^0.0.1",
    "@gkd-kit/tools": "^0.8.0",
    "@types/node": "^26.0.0",
    "lint-staged": "^17.0.8",
    "oxfmt": "^0.54.0",
    "oxlint": "^1.69.0",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^6.0.3"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged",
    "pre-push": "pnpm run check"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern",
    "*.{js,jsx,ts,tsx,mjs,cjs}": "pnpm run lint"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.31.0"
}
